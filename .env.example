# Токен бота от @BotFather
BOT_TOKEN=123456:ABC-DEF
# Куда слать: ваш chat id (узнать у @userinfobot) или @имя_канала, где бот админ
CHAT_ID=123456789
# Отдельные каналы (бот должен быть в них админом). Если не заданы — всё идёт в CHAT_ID.
# CHAT_FEED=-1001234567890
# CHAT_URGENT=-1009876543210

# Опционально: чтение Telegram-каналов через ваш аккаунт (https://my.telegram.org)
# TG_API_ID=12345
# TG_API_HASH=abcdef0123456789
